// app.rc — KeyLock Indicator kaynak betiği (spec §3.5, §7, §8).
//
// UTF-8 olarak kaydedilir. #pragma code_page(65001) olmadan rc.exe dizeleri
// sistem ANSI kod sayfasıyla okur ve Türkçe karakterler bozulur.
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>

#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Dile bağlı olmayan kaynaklar. Diyalog ve ikonlar nötr bırakılır: böylece
// kullanıcının MUI sıralaması ne olursa olsun FindResource daima bulur.
// Yalnızca STRINGTABLE'lar dile bağlıdır (Localization.cpp blokları dil
// kimliğiyle doğrudan arar).
//
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/////////////////////////////////////////////////////////////////////////////
//
// Manifest — linker'ın kendi manifesti /MANIFEST:NO ile kapatıldığı için
// uygulamanın TEK manifest kaynağı burasıdır (spec §8).
//
1                       RT_MANIFEST             "app.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// İkonlar. IDI_APP ilk sırada: Explorer bir .exe'nin ilk (en küçük kimlikli)
// ikonunu dosya simgesi olarak kullanır — tray ikonlarından biri öne geçerse
// kabuk yanlış simgeyi gösterir.
//
IDI_APP                 ICON                    "icons/app.ico"

IDI_TRAY_CAPS_OFF_DARK    ICON                  "icons/tray_caps_off_dark.ico"
IDI_TRAY_CAPS_ON_DARK     ICON                  "icons/tray_caps_on_dark.ico"
IDI_TRAY_NUM_OFF_DARK     ICON                  "icons/tray_num_off_dark.ico"
IDI_TRAY_NUM_ON_DARK      ICON                  "icons/tray_num_on_dark.ico"
IDI_TRAY_SCROLL_OFF_DARK  ICON                  "icons/tray_scroll_off_dark.ico"
IDI_TRAY_SCROLL_ON_DARK   ICON                  "icons/tray_scroll_on_dark.ico"
IDI_TRAY_CAPS_OFF_LIGHT   ICON                  "icons/tray_caps_off_light.ico"
IDI_TRAY_CAPS_ON_LIGHT    ICON                  "icons/tray_caps_on_light.ico"
IDI_TRAY_NUM_OFF_LIGHT    ICON                  "icons/tray_num_off_light.ico"
IDI_TRAY_NUM_ON_LIGHT     ICON                  "icons/tray_num_on_light.ico"
IDI_TRAY_SCROLL_OFF_LIGHT ICON                  "icons/tray_scroll_off_light.ico"
IDI_TRAY_SCROLL_ON_LIGHT  ICON                  "icons/tray_scroll_on_light.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Sürüm bilgisi. İki dil bloğu da listelenir; Explorer kullanıcının diline
// uyanı gösterir, bulamazsa ilk bloğa düşer.
//
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041F04B0"                        // Türkçe (Türkiye), Unicode
        BEGIN
            VALUE "CompanyName",      "ShadesOfDeath"
            VALUE "FileDescription",  "KeyLock Indicator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "KeyLockIndicator"
            VALUE "LegalCopyright",   "© 2026 ShadesOfDeath. Tüm hakları saklıdır."
            VALUE "OriginalFilename", "KeyLockIndicator.exe"
            VALUE "ProductName",      "KeyLock Indicator"
            VALUE "ProductVersion",   "1.0.0.0"
        END
        BLOCK "040904B0"                        // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "ShadesOfDeath"
            VALUE "FileDescription",  "KeyLock Indicator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "KeyLockIndicator"
            VALUE "LegalCopyright",   "© 2026 ShadesOfDeath. All rights reserved."
            VALUE "OriginalFilename", "KeyLockIndicator.exe"
            VALUE "ProductName",      "KeyLock Indicator"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x41F, 1200, 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Ayarlar penceresi (spec §4.6). Buradaki metinler yalnızca yer tutucudur:
// SettingsDialog::ApplyLocalizedText çalışma zamanında IDS_SET_* dizeleriyle
// hepsini değiştirir. Yine de anlamlı bırakıldılar — kaynak düzenleyicide ve
// dil yüklemesi başarısız olursa pencere okunabilir kalsın.
//
// GROUPBOX YOK. Win32 grup çerçevesi koyu temaya uymaz; hangi tema kurulu olursa
// olsun parlak "etched" bir dikdörtgen çizer ve koyu zeminde kalın beyaz bir
// kutu gibi görünür (kullanıcı şikayeti: "çok fazla border"). Onun yerine Rufus
// düzeni kullanılır: IDC_GRP_* kimlikleri bölüm BAŞLIĞI (LTEXT, büyük harf,
// vurgulu renk) olur, başlık metninin SAĞINDAN pencere kenarına kadar uzanan
// 1 piksellik çizgi src/SettingsPaint.cpp içinde (WM_ERASEBKGND) çizilir.
// Başlık statiği yalnızca metnini kaplayacak şekilde çalışma zamanında
// kısaltılır (SettingsPaint::LayoutSectionHeaders) — aksi hâlde statiğin kendi
// zemin dolgusu çizgiyi siler. Şablondaki 284 genişlik yalnızca üst sınırdır.
// SS_CENTERIMAGE: metin kontrol yüksekliğinde dikey ortalanır, böylece çizgi
// kontrolün orta çizgisine konduğunda metnin de ortasından geçer.
//
// Izgara (DLU): bölüm başlığı x=8 (içerikten hafif dışa taşar), etiket ve onay
// kutusu kolonu x=14, kontrol kolonu x=110 w=150, sağ kenar 292. Satır adımı 14,
// kaydırıcı satırları 22, bölümler arası 11. Toplam yükseklik 328 (<= 330).
// Üç kilit tuşu onay kutusu tek satıra alındı: dikey bütçeyi 26 DLU düşürüyor ve
// aynı türden üç seçenek Rufus'ta da yan yana durur.
//
IDD_SETTINGS DIALOGEX 0, 0, 300, 328
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "KeyLock Indicator - Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // --- GENEL ---------------------------------------------------------
    LTEXT           "GENERAL", IDC_GRP_GENERAL, 8, 7, 284, 10,
                    SS_LEFT | SS_CENTERIMAGE
    AUTOCHECKBOX    "Show the on-screen display (OSD)", IDC_CHK_SHOWOSD,
                    14, 22, 266, 10
    AUTOCHECKBOX    "Start with Windows", IDC_CHK_AUTOSTART,
                    14, 36, 266, 10
    LTEXT           "Language:", IDC_LBL_LANGUAGE, 14, 52, 91, 9
    // COMBOBOX yüksekliği açılır listeyi de kapsar; kapalı kutu yazı tipine göre
    // ~14 DLU olur, 60 yalnızca listeye yer bırakır.
    COMBOBOX        IDC_CMB_LANGUAGE, 110, 50, 150, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // --- İZLENEN TUŞLAR ------------------------------------------------
    LTEXT           "MONITORED KEYS", IDC_GRP_KEYS, 8, 75, 284, 10,
                    SS_LEFT | SS_CENTERIMAGE
    AUTOCHECKBOX    "Caps Lock", IDC_CHK_WATCHCAPS, 14, 90, 90, 10
    AUTOCHECKBOX    "Num Lock", IDC_CHK_WATCHNUM, 110, 90, 90, 10
    AUTOCHECKBOX    "Scroll Lock", IDC_CHK_WATCHSCROLL, 206, 90, 86, 10
    LTEXT           "Tray icon:", IDC_LBL_TRAYKEY, 14, 106, 91, 9
    COMBOBOX        IDC_CMB_TRAYKEY, 110, 104, 150, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // --- OSD GÖRÜNÜMÜ --------------------------------------------------
    LTEXT           "OSD APPEARANCE", IDC_GRP_OSD, 8, 129, 284, 10,
                    SS_LEFT | SS_CENTERIMAGE
    LTEXT           "Visible for:", IDC_LBL_DURATION, 14, 147, 91, 9
    CONTROL         "", IDC_SLD_DURATION, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,
                    110, 144, 132, 20
    RTEXT           "1400 ms", IDC_VAL_DURATION, 248, 147, 44, 9
    LTEXT           "Card opacity:", IDC_LBL_OPACITY, 14, 169, 91, 9
    CONTROL         "", IDC_SLD_OPACITY, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,
                    110, 166, 132, 20
    RTEXT           "82 %", IDC_VAL_OPACITY, 248, 169, 44, 9
    LTEXT           "Position:", IDC_LBL_POSITION, 14, 190, 91, 9
    COMBOBOX        IDC_CMB_POSITION, 110, 188, 150, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Edge margin:", IDC_LBL_MARGIN, 14, 206, 91, 9
    EDITTEXT        IDC_EDT_MARGIN, 110, 204, 46, 14,
                    ES_NUMBER | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    // Yukarı/aşağı düğmesi buddy'sini z-sırasındaki önceki kontrolden alır;
    // bu yüzden IDC_EDT_MARGIN hemen üstünde durmalıdır.
    CONTROL         "", IDC_SPN_MARGIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS |
                    UDS_NOTHOUSANDS | WS_TABSTOP,
                    156, 204, 12, 14
    LTEXT           "Theme:", IDC_LBL_THEME, 14, 222, 91, 9
    COMBOBOX        IDC_CMB_THEME, 110, 220, 150, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // --- DAVRANIŞ ------------------------------------------------------
    LTEXT           "BEHAVIOR", IDC_GRP_BEHAVIOR, 8, 245, 284, 10,
                    SS_LEFT | SS_CENTERIMAGE
    AUTOCHECKBOX    "Hide while a full-screen app is running",
                    IDC_CHK_SUPPRESSFS, 14, 260, 266, 10
    AUTOCHECKBOX    "Always show on the primary monitor",
                    IDC_CHK_PRIMARYONLY, 14, 274, 266, 10

    // --- Alt satır -----------------------------------------------------
    LTEXT           "Changes take effect immediately; no restart needed.",
                    IDC_LBL_HINT, 14, 292, 278, 9
    PUSHBUTTON      "Restore defaults", IDC_BTN_DEFAULTS, 110, 306, 88, 15
    DEFPUSHBUTTON   "Close", IDC_BTN_CLOSE, 204, 306, 88, 15
END

