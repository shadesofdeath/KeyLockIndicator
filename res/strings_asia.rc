// strings_asia.rc — ja, ko, zh-CN, zh-TW.
// Bkz. strings.rc başlığındaki kurallar (LANGID eşleşmesi, biçim dizeleri).
//
// zh-CN ile zh-TW yalnızca SUBLANG ile ayrışır (0x0804 / 0x0404); alt dil yanlış
// yazılırsa FindResourceExW sessizce diğer tabloyu getirir.

/////////////////////////////////////////////////////////////////////////////
// 日本語
/////////////////////////////////////////////////////////////////////////////
LANGUAGE LANG_JAPANESE, SUBLANG_JAPANESE_JAPAN
STRINGTABLE
BEGIN
    IDS_APPNAME             "KeyLock Indicator"
    IDS_KEY_CAPS            "CAPS LOCK"
    IDS_KEY_NUM             "NUM LOCK"
    IDS_KEY_SCROLL          "SCROLL LOCK"
    IDS_STATE_ON            "オン"
    IDS_STATE_OFF           "オフ"

    IDS_MENU_SETTINGS       "設定"
    IDS_MENU_AUTOSTART      "Windows と一緒に起動"
    IDS_MENU_TOGGLEOSD      "画面表示を一時停止"
    IDS_MENU_ABOUT          "バージョン情報"
    IDS_MENU_EXIT           "終了"

    IDS_ABOUT_TITLE         "KeyLock Indicator について"
    IDS_ABOUT_DESC          "Caps Lock、Num Lock、Scroll Lock の状態を画面上部の小さなカードと通知領域のアイコンで表示します。"
