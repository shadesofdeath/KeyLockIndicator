    IDS_OEM_BODY            "お使いのデバイスでは、メーカー独自のキー表示ツール (%s) が既に動作している可能性があります。2 つの表示が同時に出る場合は、画面表示をオフにして通知領域のアイコンだけを使うこともできます。"
    IDS_OEM_DONTSHOW        "次回から表示しない"

    IDS_SET_TITLE           "KeyLock Indicator - 設定"
    IDS_SET_GRP_GENERAL     "全般"
    IDS_SET_SHOWOSD         "画面表示 (OSD) を表示する"
    IDS_SET_AUTOSTART       "Windows と一緒に起動"
    IDS_SET_LANGUAGE        "言語:"
    IDS_SET_GRP_KEYS        "監視するキー"
    IDS_SET_WATCHCAPS       "Caps Lock"
    IDS_SET_WATCHNUM        "Num Lock"
    IDS_SET_WATCHSCROLL     "Scroll Lock"
    IDS_SET_TRAYKEY         "通知領域のアイコン:"
    IDS_SET_GRP_OSD         "画面表示の外観"
    IDS_SET_DURATION        "表示時間:"
    IDS_SET_OPACITY         "カードの不透明度:"
    IDS_SET_POSITION        "位置:"
    IDS_SET_MARGIN          "画面端からの余白:"
    IDS_SET_THEME           "テーマ:"
    IDS_SET_GRP_BEHAVIOR    "動作"
    IDS_SET_SUPPRESSFS      "全画面アプリの実行中は表示しない"
    IDS_SET_DEFAULTS        "既定値に戻す"
    IDS_SET_CLOSE           "閉じる"
    IDS_SET_HINT            "変更はすぐに反映されます。再起動は不要です。"
    IDS_SET_SCALE           "カードの大きさ:"
    IDS_SET_ONLYON          "オンにしたときだけ"
    IDS_SET_TRAYCLICK       "アイコンの左クリック:"

    IDS_POS_TOP             "上部中央"
    IDS_POS_CENTER          "中央"
    IDS_POS_BOTTOM          "下部中央"
    IDS_THEME_SYSTEM        "システムに合わせる"
    IDS_THEME_LIGHT         "ライト"
    IDS_THEME_DARK          "ダーク"
    IDS_LANG_AUTO           "自動"

    IDS_UNIT_MS             "ミリ秒"
    IDS_UNIT_PERCENT        "%"
    IDS_TRAYCLICK_OSD       "画面表示を出す"
    IDS_TRAYCLICK_SETTINGS  "設定を開く"
    IDS_TRAYCLICK_NONE      "何もしない"

    IDS_POS_TOPLEFT         "左上"
    IDS_POS_TOPRIGHT        "右上"
    IDS_POS_MIDLEFT         "中央左"
    IDS_POS_MIDRIGHT        "中央右"
    IDS_POS_BOTLEFT         "左下"
    IDS_POS_BOTRIGHT        "右下"
    IDS_POS_CUSTOM          "自由配置"
    IDS_SET_PICKPOS         "画面で選ぶ..."
    IDS_SET_PICKHINT        "カードを好きな場所へドラッグして離してください - Esc で取り消します。"

    IDS_SET_MONITOR         "表示するモニター:"
    IDS_MON_CURSOR          "マウスポインターのあるモニター"
    IDS_MON_PRIMARY         "常にメイン モニター"
    IDS_MON_ALL             "すべてのモニター"

    IDS_SET_HOTKEY          "グローバル ショートカット"
    IDS_HOTKEY_FAILED       "このショートカットは他のアプリが使用中です。別の組み合わせを選んでください。"

    IDS_SET_VIEWMODE        "表示形式:"
    IDS_VIEW_ICONTEXT       "アイコンと文字"
    IDS_VIEW_ICONONLY       "アイコンのみ"
    IDS_VIEW_BAR            "細いバー"
    IDS_SET_BADGE           "常に表示"
    IDS_SET_ANNOUNCE        "スクリーン リーダーに通知"

    IDS_SET_GRP_EXCLUDE     "除外するアプリ"
    IDS_SET_EXCL_ADD        "追加..."
    IDS_SET_EXCL_DEL        "削除"
    IDS_FILTER_EXE          "アプリケーション (*.exe)"
    IDS_FILTER_INI          "設定ファイル (*.ini)"
    IDS_SET_EXPORT          "エクスポート..."
    IDS_SET_IMPORT          "インポート..."
    IDS_IMPORT_FAILED       "設定ファイルを読み込めませんでした。設定は変更されていません。"
    IDS_EXPORT_FAILED       "設定をそのファイルに書き込めませんでした。"
    IDS_STORAGE_REGISTRY    "設定はレジストリ (HKCU) に保存されます。"
    IDS_STORAGE_PORTABLE    "ポータブル モード: 設定は %s に保存されます (自動起動は引き続きレジストリを使います)。"
    IDS_SET_WATCHLAYOUT     "キーボード レイアウトの切り替えを通知"
    IDS_LAYOUT_TITLE        "キーボード"
END

